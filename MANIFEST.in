# Exclude everything by default
global-exclude *

# Include essential project files
include CITATION.cff
include CONTRIBUTING.md
include CONTRIBUTORS.md
include LICENSE
include pyproject.toml
include README.md

# Include source code
graft src

# Include tests (useful for conda package)
graft tests

# Exclude test outputs
prune tests/outputs

# Exclude common build artifacts, cache files and agent instructions
global-exclude *.py[cod] __pycache__ *.so CLAUDE.md
